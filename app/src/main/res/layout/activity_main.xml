<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:padding="@dimen/space"
    android:background="@color/background">

    <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView style="@style/Title" android:layout_width="wrap_content"
            android:text="@string/brand" android:textColor="@color/gold" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/actionable_alert" style="@style/Body" android:layout_width="wrap_content"
            android:visibility="gone" android:textColor="@color/gold" android:layout_marginEnd="12dp" />
        <Button android:id="@+id/settings_button" style="@style/Action"
            android:layout_width="wrap_content" android:text="@string/settings" />
    </LinearLayout>

    <FrameLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="@dimen/space" android:layout_marginBottom="@dimen/space">
        <!-- Physical speed position stays left; Arabic text and navigation stay RTL. -->
        <LinearLayout android:id="@+id/home_panel" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="horizontal" android:layoutDirection="ltr">
            <LinearLayout android:id="@+id/speed_card" style="@style/Card" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="0.32"
                android:layout_marginStart="@dimen/space" android:gravity="center">
                <TextView style="@style/Body" android:gravity="center" android:text="@string/speed" />
                <TextView android:id="@+id/speed_value" style="@style/Title" android:text="@string/speed_empty"
                    android:contentDescription="@string/speed_accessibility"
                    android:gravity="center" android:textSize="80sp" android:textColor="@color/accent" />
                <TextView style="@style/Body" android:text="@string/kmh" android:gravity="center" />
                <TextView android:id="@+id/speed_source" style="@style/Body" android:layout_marginTop="24dp" android:gravity="center"
                    android:text="@string/gps_unavailable" android:textSize="16sp" />
                <Button android:id="@+id/quick_map" style="@style/Action" android:layout_width="match_parent"
                    android:layout_marginTop="16dp" android:text="@string/home_quick_map" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="0.68" android:orientation="vertical" android:layoutDirection="rtl">
                <LinearLayout android:id="@+id/navigation_card" style="@style/Card"
                    android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="0.58" android:gravity="center_vertical">
                    <TextView style="@style/Body" android:text="@string/map" android:textColor="@color/accent" />
                    <TextView style="@style/Title" android:layout_marginTop="8dp" android:text="@string/navigation_title" />
                    <TextView android:id="@+id/navigation_instruction" style="@style/Title" android:layout_marginTop="8dp"
                        android:text="@string/navigation_unavailable" android:textSize="24sp" />
                    <TextView android:id="@+id/navigation_eta" style="@style/Body" android:layout_marginTop="6dp"
                        android:text="@string/navigation_eta_unavailable" />
                    <TextView android:id="@+id/navigation_state" style="@style/Body" android:layout_marginTop="8dp"
                        android:text="@string/navigation_state" android:textColor="@color/gold" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
                    android:layout_weight="0.42" android:layout_marginTop="@dimen/space"
                    android:orientation="horizontal">
                    <LinearLayout style="@style/Card" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginEnd="@dimen/space_small" android:gravity="center_vertical">
                        <TextView style="@style/Title" android:text="@string/media" android:textSize="24sp" />
                        <TextView android:id="@+id/media_track" style="@style/Body" android:layout_marginTop="6dp"
                            android:text="@string/media_track_unavailable" android:textColor="@color/text_primary" />
                        <TextView android:id="@+id/media_state" style="@style/Body" android:layout_marginTop="6dp"
                            android:text="@string/media_stopped" />
                        <Button android:id="@+id/quick_media" style="@style/Action" android:layout_width="match_parent"
                            android:layout_marginTop="8dp" android:text="@string/home_quick_media" />
                    </LinearLayout>
                    <LinearLayout style="@style/Card" android:layout_width="0dp"
                        android:layout_height="match_parent" android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_small" android:gravity="center_vertical">
                        <TextView android:id="@+id/vehicle_summary" style="@style/Body"
                            android:text="@string/home_normal" android:textColor="@color/text_primary" />
                        <TextView style="@style/Body" android:layout_marginTop="8dp" android:id="@+id/vehicle_state" android:text="@string/vehicle_stale" android:textColor="@color/gold" />
                        <Button android:id="@+id/quick_vehicle" style="@style/Action" android:layout_width="match_parent"
                            android:layout_marginTop="8dp" android:text="@string/home_quick_vehicle" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/map_panel" style="@style/Card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Title" android:text="@string/map_title" />
                    <TextView android:id="@+id/map_engine_state" style="@style/Body"
                        android:text="@string/map_engine_missing" android:textColor="@color/gold" />
                </LinearLayout>
                <Button android:id="@+id/map_back_home" style="@style/Action"
                    android:layout_width="wrap_content" android:text="@string/back_home" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/touch_height"
                android:orientation="horizontal" android:layout_marginTop="@dimen/space_small">
                <EditText android:id="@+id/map_search_input" android:layout_width="0dp"
                    android:layout_height="@dimen/touch_height" android:layout_weight="1"
                    android:singleLine="true" android:imeOptions="actionSearch"
                    android:inputType="text" android:hint="@string/map_search_hint"
                    android:textSize="@dimen/text_body" android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" android:paddingStart="16dp"
                    android:paddingEnd="16dp" android:background="@drawable/action_background" />
                <Button android:id="@+id/map_search_button" style="@style/Action"
                    android:layout_width="140dp" android:layout_marginStart="@dimen/space_small"
                    android:text="@string/map_search_action" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/touch_height"
                android:orientation="horizontal" android:layout_marginTop="@dimen/space_small">
                <Button android:id="@+id/map_open_button" style="@style/Action"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/map_open_osmand" />
                <Button android:id="@+id/map_location_button" style="@style/Action"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_small" android:text="@string/map_my_location" />
                <Button android:id="@+id/map_refresh_button" style="@style/Action"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_small" android:text="@string/map_refresh_route" />
            </LinearLayout>

            <TextView android:id="@+id/map_route_title" style="@style/Title"
                android:layout_marginTop="16dp" android:text="@string/map_route_unknown"
                android:textSize="24sp" />
            <TextView android:id="@+id/map_route_detail" style="@style/Body"
                android:layout_marginTop="6dp" android:text="@string/map_route_unknown_detail" />
            <TextView android:id="@+id/map_feedback" style="@style/Body"
                android:layout_marginTop="10dp" android:textColor="@color/gold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/media_panel" style="@style/Card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:gravity="center_vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView style="@style/Title" android:layout_width="0dp" android:layout_weight="1"
                    android:text="@string/media_title" />
                <Button android:id="@+id/media_back_home" style="@style/Action"
                    android:layout_width="wrap_content" android:text="@string/back_home" />
            </LinearLayout>
            <TextView android:id="@+id/media_now_title" style="@style/Title"
                android:text="@string/media_no_session" android:textSize="30sp" />
            <TextView android:id="@+id/media_now_artist" style="@style/Body"
                android:layout_marginTop="8dp" android:text="@string/media_no_session_detail" />
            <TextView android:id="@+id/media_now_status" style="@style/Body"
                android:layout_marginTop="10dp" android:text="@string/media_stopped"
                android:textColor="@color/gold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/touch_height"
                android:orientation="horizontal" android:layout_marginTop="18dp">
                <Button android:id="@+id/media_previous_button" style="@style/Action"
                    android:layout_width="0dp" android:layout_weight="1" android:text="@string/media_previous" />
                <Button android:id="@+id/media_play_pause_button" style="@style/Action"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_small" android:text="@string/media_play" />
                <Button android:id="@+id/media_next_button" style="@style/Action"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_small" android:text="@string/media_next" />
            </LinearLayout>
            <TextView android:id="@+id/media_local_summary" style="@style/Body"
                android:layout_marginTop="12dp" android:text="@string/media_local_not_scanned" />
            <Button android:id="@+id/media_local_scan_button" style="@style/Action"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="@string/media_local_scan" />
            <Button android:id="@+id/media_access_button" style="@style/Action"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"
                android:text="@string/media_access_action" />
        </LinearLayout>

        <LinearLayout android:id="@+id/vehicle_panel" style="@style/Card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/Title" android:text="@string/vehicle" android:gravity="center" />
            <TextView android:id="@+id/vehicle_pressure" style="@style/Body" android:layout_marginTop="20dp" android:gravity="center" />
            <TextView android:id="@+id/vehicle_tire_temperature" style="@style/Body" android:layout_marginTop="12dp" android:gravity="center" />
            <TextView android:id="@+id/vehicle_fridge_temperature" style="@style/Body" android:layout_marginTop="12dp" android:gravity="center" />
            <TextView android:id="@+id/vehicle_source" style="@style/Body" android:layout_marginTop="16dp"
                android:textColor="@color/gold" android:gravity="center" />
            <Button android:id="@+id/vehicle_back_home" style="@style/Action" android:layout_width="wrap_content"
                android:layout_marginTop="20dp" android:text="@string/back_home" />
        </LinearLayout>

        <LinearLayout android:id="@+id/settings_panel" style="@style/Card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/settings_title" style="@style/Title" android:text="@string/settings" android:gravity="center" />
            <TextView style="@style/Body" android:layout_marginTop="12dp"
                android:text="@string/settings_user_detail" android:gravity="center" />
            <Button android:id="@+id/settings_speed_button" style="@style/Action"
                android:layout_width="match_parent" android:layout_marginTop="18dp" />
            <TextView style="@style/Body" android:layout_marginTop="8dp"
                android:text="@string/settings_speed_detail" android:gravity="center" />
            <Button android:id="@+id/settings_standby_button" style="@style/Action"
                android:layout_width="match_parent" android:layout_marginTop="12dp"
                android:text="@string/standby_enter" />
            <Button android:id="@+id/settings_back_home" style="@style/Action"
                android:layout_width="wrap_content" android:layout_marginTop="20dp"
                android:text="@string/back_home" />
        </LinearLayout>

        <LinearLayout android:id="@+id/admin_panel" style="@style/Card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:orientation="vertical" android:gravity="center">
            <TextView style="@style/Title" android:text="@string/admin_title" android:gravity="center" />
            <TextView android:id="@+id/admin_app" style="@style/Body" android:layout_marginTop="14dp" android:gravity="center" />
            <TextView android:id="@+id/admin_device" style="@style/Body" android:layout_marginTop="10dp" android:gravity="center" />
            <TextView android:id="@+id/admin_update" style="@style/Body" android:layout_marginTop="10dp" android:gravity="center" />
            <TextView android:id="@+id/admin_recovery" style="@style/Body" android:layout_marginTop="10dp" android:gravity="center" />
            <TextView android:id="@+id/admin_update_inspection" style="@style/Body" android:layout_marginTop="10dp" android:gravity="center" />
            <Button android:id="@+id/admin_inspect_update" style="@style/Action" android:layout_width="wrap_content" android:layout_marginTop="12dp" android:text="@string/admin_inspect_update" />
            <Button android:id="@+id/admin_back_settings" style="@style/Action"
                android:layout_width="wrap_content" android:layout_marginTop="20dp"
                android:text="@string/admin_back_settings" />
        </LinearLayout>

        <LinearLayout android:id="@+id/standby_panel"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:orientation="vertical" android:gravity="center"
            android:background="@color/background" android:padding="32dp">
            <TextView style="@style/Title" android:text="@string/standby_title"
                android:gravity="center" android:textSize="34sp" />
            <TextView style="@style/Body" android:text="@string/standby_detail"
                android:gravity="center" android:layout_marginTop="16dp" />
            <Button android:id="@+id/standby_exit" style="@style/Action"
                android:layout_width="wrap_content" android:layout_marginTop="28dp"
                android:text="@string/standby_exit_hold" />
        </LinearLayout>

        <LinearLayout android:id="@+id/section_panel" style="@style/Card"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:gravity="center">
            <TextView android:id="@+id/section_title" style="@style/Title" android:gravity="center" />
            <TextView android:id="@+id/section_detail" style="@style/Body" android:gravity="center"
                android:layout_marginTop="16dp" />
            <TextView android:id="@+id/section_note" style="@style/Body" android:text="@string/placeholder_note" android:gravity="center"
                android:textColor="@color/gold" android:layout_marginTop="16dp" />
            <LinearLayout android:id="@+id/apps_preview" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center" android:layout_marginTop="16dp" android:visibility="gone">
                <Button android:id="@+id/apps_recent" android:enabled="false" android:alpha="0.55" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:text="@string/apps_recent" />
                <Button android:id="@+id/apps_favorite" android:enabled="false" android:alpha="0.55" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="@dimen/space_small" android:text="@string/apps_favorite" />
                <Button android:id="@+id/apps_manage" android:enabled="false" android:alpha="0.55" style="@style/Action" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="@dimen/space_small" android:text="@string/apps_manage" />
            </LinearLayout>
            <Button android:id="@+id/back_home" style="@style/Action" android:layout_width="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/back_home" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/navigation" android:layout_width="match_parent"
        android:layout_height="@dimen/touch_height" android:orientation="horizontal">
        <Button android:id="@+id/nav_home" style="@style/NavAction" android:text="@string/home" />
        <Button android:id="@+id/nav_map" style="@style/NavAction" android:text="@string/map" />
        <Button android:id="@+id/nav_media" style="@style/NavAction" android:text="@string/media" />
        <Button android:id="@+id/nav_vehicle" style="@style/NavAction" android:text="@string/vehicle" />
        <Button android:id="@+id/nav_apps" style="@style/NavAction" android:text="@string/apps" />
    </LinearLayout>
</LinearLayout>
