<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#5539A9FF">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape><solid android:color="@color/border" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:state_focused="true">
                <shape><solid android:color="@color/border" /><corners android:radius="12dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/surface" /><corners android:radius="12dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
